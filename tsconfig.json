{
    "extends": "@apify/tsconfig",
    "compilerOptions": {
        "module": "ES2022",
        "moduleResolution": "node",
        "target": "ES2022",
        "outDir": "dist",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noUnusedLocals": false,
        "lib": ["ES2022", "DOM"]
    },
    "include": [
        "./src/**/*.ts"
    ],
    "exclude": ["node_modules"]
}
